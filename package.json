{
  "name": "parsegraph",
  "version": "7.0.1",
  "packageManager": "yarn@1.22.22",
  "description": "Parsegraph layout algorithm for graphs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dafrito/parsegraph.git"
  },
  "author": "Rainback, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dafrito/parsegraph/issues"
  },
  "homepage": "https://parsegraph.com",
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.20.5",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@babel/register": "^7.18.9",
    "@types/chai": "^4.3.4",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "babel-jest": "^29.4.1",
    "babel-loader": "^9.1.2",
    "chai": "^4.3.7",
    "eslint": "^8.33.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jsdom": "^21.1.0",
    "jsdom-global": "^3.0.2",
    "parsegraph-color": "1.5.1",
    "prettier": "^2.8.3",
    "raw-loader": "^4.0.2",
    "source-map-loader": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typedoc": "^0.23.24",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "scripts": {
    "bench": "python3 tools/bench/bench.py run",
    "bench:report": "python3 tools/bench/bench.py report",
    "bench:check": "tsc -p tools/bench/tsconfig.json --noEmit && python3 -m unittest discover -s tools/bench -p 'test_*.py'",
    "generate:proportion": "ts-node --project examples/tsconfig.json examples/generators/proportion.ts --output generated/proportion.parsegraph",
    "generate:proportion:v1": "ts-node --project examples/tsconfig.json examples/generators/proportion.ts --format v1 --output generated/proportion-v1.parsegraph",
    "generate:ulam": "ts-node --project examples/tsconfig.json examples/generators/ulam.ts --output generated/ulam.parsegraph",
    "generate:ulam:v0": "ts-node --project examples/tsconfig.json examples/generators/ulam.ts --format v0 --output generated/ulam-v0.parsegraph",
    "generate:primes": "ts-node --project examples/tsconfig.json examples/generators/primes.ts --output generated/primes.parsegraph",
    "generate:primes:v0": "ts-node --project examples/tsconfig.json examples/generators/primes.ts --format v0 --output generated/primes-v0.parsegraph",
    "generate:memory-piers": "ts-node --project examples/tsconfig.json examples/generators/memory-piers.ts --output generated/memory-piers.parsegraph",
    "generate:memory-piers:v0": "ts-node --project examples/tsconfig.json examples/generators/memory-piers.ts --format v0 --output generated/memory-piers-v0.parsegraph",
    "generate:rainbow": "ts-node --project examples/tsconfig.json examples/generators/rainbow.ts --output generated/rainbow.parsegraph",
    "generate:rainbow:vertical": "ts-node --project examples/tsconfig.json examples/generators/rainbow.ts --vertical --output generated/rainbow-vertical.parsegraph",
    "svg:check": "tsc --project tools/svg/tsconfig.json",
    "svg:build": "webpack --config tools/svg/webpack.config.js",
    "render:svg": "yarn svg:build && ts-node --project tools/svg/tsconfig.json tools/svg/cli.ts",
    "examples:check": "tsc --project examples/tsconfig.json",
    "pack:preview": "yarn build:prod && node tools/pack-preview.cjs",
    "all": "yarn lint:ci && yarn test:cov && yarn build && yarn doc",
    "build": "webpack --mode development --config config/webpack.config.js",
    "build:watch": "yarn build --watch",
    "build:prod": "node tools/build-production.cjs",
    "build:prod:watch": "NODE_ENV=production yarn build:prod --watch",
    "dependencygraph": "node tools/dependencygraph.cjs",
    "test": "jest --env=jsdom --no-cache",
    "test:watch": "yarn test --watch",
    "test:cov": "yarn test --coverage --coverageDirectory=dist/coverage",
    "prettier": "prettier --write src",
    "lint:ci": "prettier --check src && eslint 'src/**' --ignore-pattern '*.spec.js' --ignore-pattern '*.spec.ts'",
    "lint": "yarn prettier && eslint 'src/**' --fix --ignore-pattern '*.spec.js' --ignore-pattern '*.spec.ts'",
    "doc": "typedoc --tsconfig config/tsconfig.browser.json src/index.ts --out ./dist/docs",
    "clean": "./scripts/clean",
    "tar": "./scripts/tar-dev parsegraph",
    "tar:prod": "yarn pack:release",
    "pack:release": "yarn build:prod && node tools/pack-release.cjs",
    "verify:package": "node tools/verify-package.cjs",
    "test:package": "node --test tools/package.test.cjs",
    "test:maintenance": "node --test tools/maintenance.test.cjs",
    "test:release": "node --test tools/release.test.cjs",
    "prepack": "node tools/prepack.cjs"
  }
}
